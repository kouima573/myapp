{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "tileset",
              "character",
              "enemy",
              "animation",
              "portrait",
              "background"
            ]
          },
          "status": {
            "default": "draft",
            "type": "string",
            "enum": [
              "draft",
              "approved",
              "in-progress",
              "done",
              "rejected"
            ]
          },
          "mode": {
            "default": "generate",
            "type": "string",
            "enum": [
              "generate",
              "site",
              "commission"
            ]
          },
          "purpose": {
            "default": "",
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "mustHave": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "avoid": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "userNotes": {
            "default": "",
            "type": "string"
          },
          "spec": {
            "type": "object",
            "properties": {
              "cellWidth": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "cellHeight": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "columns": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "rows": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "layout": {
                "default": "",
                "type": "string"
              },
              "transparent": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "cellWidth",
              "cellHeight",
              "columns",
              "rows"
            ],
            "additionalProperties": false
          },
          "assetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "candidates": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 96,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "note": {
                  "default": "",
                  "type": "string"
                }
              },
              "required": [
                "sourceId",
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "description",
          "spec"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "requests"
  ],
  "additionalProperties": false
}
