{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "kind": {
            "type": "string",
            "enum": [
              "tileset",
              "character",
              "enemy",
              "animation",
              "portrait",
              "background",
              "bgm",
              "sfx",
              "song",
              "font"
            ]
          },
          "mimeType": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "source": {
            "default": "自作",
            "type": "string"
          },
          "license": {
            "default": "プロジェクト内素材",
            "type": "string"
          },
          "origin": {
            "default": "original",
            "type": "string",
            "enum": [
              "original",
              "generated",
              "site",
              "purchased",
              "commission"
            ]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "author": {
            "type": "string"
          },
          "licenseUrl": {
            "type": "string",
            "format": "uri"
          },
          "credit": {
            "type": "string"
          },
          "creditRequired": {
            "default": false,
            "type": "boolean"
          },
          "redistributable": {
            "default": true,
            "type": "boolean"
          },
          "commercial": {
            "type": "boolean"
          },
          "termsCheckedAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "notes": {
            "type": "string"
          },
          "request": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "generator": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean"
              ]
            }
          },
          "tileWidth": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "tileHeight": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "margin": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "spacing": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "columns": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "rows": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "frameDurationMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "frameOrder": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "loop": {
            "type": "boolean"
          },
          "initialVolume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "duck": {
            "type": "boolean"
          },
          "loopStart": {
            "type": "number",
            "minimum": 0
          },
          "loopEnd": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "path",
          "kind",
          "mimeType",
          "bytes"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "formatVersion",
    "assets"
  ],
  "additionalProperties": false
}
