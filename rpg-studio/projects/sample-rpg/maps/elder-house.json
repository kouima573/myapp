{
  "formatVersion": 2,
  "id": "elder-house",
  "title": "長老の家",
  "width": 10,
  "height": 8,
  "bgm": "song-village",
  "rows": [
    "hhhhhhhhhh",
    "hcccccccch",
    "hcccccccch",
    "hcccccccch",
    "hcccccccch",
    "hcccccccch",
    "hcccccccch",
    "hhhhdhhhhh"
  ],
  "npcs": [
    {
      "id": "elder",
      "name": "長老オババ",
      "x": 4,
      "y": 2,
      "facing": "down",
      "sprite": "village-elder",
      "dialogues": [
        {
          "when": {
            "flag": "sentinelCalmed"
          },
          "dialogue": "elder-after"
        },
        {
          "dialogue": "elder-before"
        }
      ]
    }
  ],
  "portals": [
    {
      "id": "house-to-village",
      "x": 4,
      "y": 7,
      "targetMapId": "village",
      "targetX": 8,
      "targetY": 6,
      "facing": "down"
    }
  ],
  "interactables": [
    {
      "id": "shop-shelf",
      "x": 7,
      "y": 1,
      "label": "よろず棚",
      "event": "elder-shop",
      "trigger": "action",
      "solid": true,
      "marker": "chest"
    },
    {
      "id": "diary",
      "x": 1,
      "y": 1,
      "label": "旅の日誌",
      "event": "read-diary",
      "trigger": "action",
      "solid": true,
      "marker": "sign"
    }
  ],
  "entities": [
    {
      "id": "old-book",
      "name": "古い本",
      "x": 1,
      "y": 4,
      "states": [
        {
          "when": {
            "not": {
              "set": "clues",
              "has": "ancient-script"
            }
          },
          "marker": "sign",
          "trigger": "action",
          "effects": [
            {
              "type": "message",
              "text": "ほこりをかぶった本だ。古代文字の読み方が図解されている……。"
            },
            {
              "type": "addToSet",
              "set": "clues",
              "value": "ancient-script"
            },
            {
              "type": "message",
              "text": "古代文字が少し読めるようになった。（手がかり帳に記録）"
            }
          ]
        },
        {
          "marker": "sign",
          "trigger": "action",
          "effects": [
            {
              "type": "message",
              "text": "古代文字の手引き書だ。もう内容は覚えている。"
            }
          ]
        }
      ]
    },
    {
      "id": "odd-lectern",
      "name": "ふしぎな書見台",
      "x": 8,
      "y": 1,
      "states": [
        {
          "name": "ふしぎな書見台",
          "marker": "sparkle",
          "trigger": "action",
          "solid": true,
          "effects": [
            {
              "type": "choice",
              "speaker": "書見台",
              "prompt": "古い本が開いている。どのページを読む？",
              "options": [
                {
                  "id": "time",
                  "label": "砂時計の章",
                  "effects": [
                    {
                      "type": "unlockAbility",
                      "ability": "time-sand"
                    },
                    {
                      "type": "message",
                      "text": "「時の砂」を覚えた。戦闘で時を止められる。"
                    }
                  ]
                },
                {
                  "id": "gamble",
                  "label": "賭け札の章",
                  "effects": [
                    {
                      "type": "unlockAbility",
                      "ability": "gamble-card"
                    },
                    {
                      "type": "message",
                      "text": "「賭け札」を覚えた。"
                    }
                  ]
                },
                {
                  "id": "mirror",
                  "label": "鏡の章",
                  "when": {
                    "not": {
                      "item": "echo-mirror"
                    }
                  },
                  "effects": [
                    {
                      "type": "giveItem",
                      "item": "echo-mirror"
                    },
                    {
                      "type": "message",
                      "text": "ページの間から「こだまの鏡」が出てきた。"
                    }
                  ]
                },
                {
                  "id": "fight",
                  "label": "ゆらぎの章（戦う）",
                  "effects": [
                    {
                      "type": "battle",
                      "enemy": "yuragi",
                      "onDefeat": "continue"
                    }
                  ]
                },
                {
                  "id": "close",
                  "label": "閉じる",
                  "effects": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
