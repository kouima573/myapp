{
  "formatVersion": 2,
  "events": [
    {
      "id": "village-sign",
      "label": "立て札",
      "effects": [
        {
          "type": "message",
          "text": "← 苔森の村　　｜　　橋を渡って東 → 風穴の遺跡"
        }
      ]
    },
    {
      "id": "open-ruins-shortcut",
      "label": "獣道で岩の隙間を抜ける",
      "when": {
        "ability": "beast-trail"
      },
      "once": true,
      "effects": [
        {
          "type": "setFlag",
          "flag": "ruinsShortcutOpen"
        },
        {
          "type": "message",
          "text": "獣道の感覚で足場を見つけた。岩の隙間を抜けられるようになった！"
        }
      ],
      "otherwise": [
        {
          "type": "message",
          "text": "岩の間にわずかな隙間がある。今の自分では通れそうにない……。"
        }
      ]
    },
    {
      "id": "sentinel-battle",
      "label": "石像の番人",
      "once": true,
      "effects": [
        {
          "type": "message",
          "text": "石像の目に光が宿った……！"
        },
        {
          "type": "battle",
          "enemy": "stone-sentinel",
          "canFlee": false,
          "onDefeat": "respawn"
        },
        {
          "type": "setFlag",
          "flag": "sentinelCalmed"
        },
        {
          "type": "giveItem",
          "item": "wind-shard"
        },
        {
          "type": "message",
          "text": "番人は静かに崩れ落ちた。中から淡く光る『風の欠片』が現れた。"
        }
      ]
    },
    {
      "id": "ruins-chest",
      "label": "古い宝箱",
      "once": true,
      "effects": [
        {
          "type": "giveItem",
          "item": "herb"
        },
        {
          "type": "message",
          "text": "宝箱を開けた。薬草を見つけた！"
        }
      ],
      "afterDone": [
        {
          "type": "message",
          "text": "宝箱は空っぽだ。"
        }
      ]
    },
    {
      "id": "elder-shop",
      "label": "よろず棚",
      "effects": [
        {
          "type": "choice",
          "speaker": "長老オババ",
          "prompt": "何を買うかね？（所持金 {{var.gold}}G）",
          "options": [
            {
              "id": "buy-herb",
              "label": "薬草 — 5G",
              "when": {
                "var": "gold",
                "op": ">=",
                "value": 5
              },
              "effects": [
                {
                  "type": "setVar",
                  "var": "gold",
                  "op": "sub",
                  "value": 5
                },
                {
                  "type": "giveItem",
                  "item": "herb"
                },
                {
                  "type": "message",
                  "text": "薬草を買った。"
                }
              ]
            },
            {
              "id": "buy-charm",
              "label": "幸運のお守り — 20G",
              "when": {
                "all": [
                  {
                    "var": "gold",
                    "op": ">=",
                    "value": 20
                  },
                  {
                    "not": {
                      "item": "lucky-charm"
                    }
                  }
                ]
              },
              "effects": [
                {
                  "type": "setVar",
                  "var": "gold",
                  "op": "sub",
                  "value": 20
                },
                {
                  "type": "giveItem",
                  "item": "lucky-charm"
                },
                {
                  "type": "message",
                  "text": "幸運のお守りを買った。持っているだけで攻撃+1。"
                }
              ]
            },
            {
              "id": "leave",
              "label": "やめておく",
              "effects": []
            }
          ]
        }
      ]
    },
    {
      "id": "read-diary",
      "label": "旅の日誌",
      "effects": [
        {
          "type": "system",
          "system": "chronicle",
          "action": "summary"
        }
      ]
    }
  ]
}
