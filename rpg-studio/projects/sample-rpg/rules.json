{
  "formatVersion": 2,
  "rules": [
    {
      "id": "monster-loot",
      "on": "victory",
      "when": {
        "enemyTag": "monster"
      },
      "description": "魔物を倒すと2〜5ゴールドと撃破数+1",
      "effects": [
        {
          "type": "random",
          "var": "loot",
          "min": 2,
          "max": 5
        },
        {
          "type": "setVar",
          "var": "gold",
          "op": "add",
          "value": {
            "var": "loot"
          }
        },
        {
          "type": "setVar",
          "var": "victories",
          "op": "add",
          "value": 1
        },
        {
          "type": "message",
          "text": "{{var.loot}}ゴールドを拾った。"
        }
      ]
    },
    {
      "id": "veteran",
      "on": "auto",
      "when": {
        "var": "victories",
        "op": ">=",
        "value": 3
      },
      "description": "3体倒すと攻撃力+1（1回だけ）",
      "effects": [
        {
          "type": "setStat",
          "stat": "attack",
          "op": "add",
          "value": 1
        },
        {
          "type": "setFlag",
          "flag": "veteran"
        },
        {
          "type": "message",
          "text": "戦いに慣れてきた！ 攻撃力が1上がった。"
        }
      ]
    },
    {
      "id": "spirit-regen",
      "on": "step",
      "when": {
        "compare": [
          {
            "mod": [
              {
                "steps": true
              },
              8
            ]
          },
          "==",
          0
        ]
      },
      "description": "8歩ごとに気力+1",
      "effects": [
        {
          "type": "setVar",
          "var": "spirit",
          "op": "add",
          "value": 1
        }
      ]
    },
    {
      "id": "wind-returns",
      "on": "mapEnter",
      "once": "game",
      "when": {
        "all": [
          {
            "map": "village"
          },
          {
            "flag": "sentinelCalmed"
          }
        ]
      },
      "description": "番人を倒した後に村へ戻ると",
      "effects": [
        {
          "type": "message",
          "text": "村に風が戻ってきた。木々がざわめいている。"
        }
      ]
    },
    {
      "id": "whistle-tet",
      "on": "signal",
      "match": "whistle",
      "when": {
        "map": "village"
      },
      "description": "村で口笛を吹くとテトが反応する",
      "effects": [
        {
          "type": "message",
          "speaker": "見習いのテト",
          "text": "呼んだ？　……なんだ、口笛か。"
        }
      ]
    },
    {
      "id": "whistle-wind",
      "on": "signal",
      "match": "whistle",
      "when": {
        "flag": "wind-form"
      },
      "description": "風の姿だと口笛が遠くまで届く",
      "effects": [
        {
          "type": "message",
          "text": "口笛は風に乗って、森の向こうまで届いた。"
        }
      ]
    },
    {
      "id": "examine-tree",
      "on": "examine",
      "when": {
        "front": {
          "tile": "T"
        }
      },
      "description": "何もない所を調べた時: 木の前なら",
      "effects": [
        {
          "type": "message",
          "text": "木の幹に、子どもが刻んだような小さな印がある。"
        }
      ]
    },
    {
      "id": "wind-water",
      "on": "bump",
      "when": {
        "all": [
          {
            "flag": "wind-form"
          },
          {
            "front": {
              "tile": "~"
            }
          }
        ]
      },
      "once": "map",
      "description": "風の姿で水辺にぶつかった時",
      "effects": [
        {
          "type": "message",
          "text": "風の身でも、水の上は渡れないらしい。"
        }
      ]
    },
    {
      "id": "learn-recall",
      "on": "auto",
      "when": {
        "compare": [
          {
            "size": "clues"
          },
          ">=",
          1
        ]
      },
      "description": "手がかりを一つ得ると『思い出す』を覚える",
      "effects": [
        {
          "type": "learnVerb",
          "verb": "recall"
        },
        {
          "type": "message",
          "text": "（新しい行動『思い出す』を覚えた。メニューか O キーで使える）"
        }
      ]
    },
    {
      "id": "recall-rune",
      "on": "verb",
      "match": "recall",
      "when": {
        "target": "rune-order"
      },
      "description": "石板の順番を思い出すと遺跡の扉の前でヒント",
      "effects": [
        {
          "type": "if",
          "when": {
            "map": "ruins"
          },
          "then": [
            {
              "type": "message",
              "text": "星・月・太陽……この順で石板を回せばいい。"
            }
          ]
        }
      ]
    }
  ]
}
