      ],
      "bgm": [
        "generate",
        "site"
      ],
      "sfx": [
        "generate",
        "site"
      ]
    },
    "budget": {
      "warnTotalMB": 50,
      "maxTotalMB": 100,
      "maxFileMB": 10
    }
  },
  "credits": [
    "企画・データ: RPGシステム工房 サンプル",
