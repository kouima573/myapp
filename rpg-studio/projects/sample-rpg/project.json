{
  "formatVersion": 2,
  "id": "sample-rpg",
  "title": "森境の小さな冒険",
  "engineCompatibility": {
    "min": "0.3.0"
  },
  "start": {
    "mapId": "village",
    "x": 3,
    "y": 9,
    "facing": "right"
  },
  "player": {
    "name": "アオ",
    "sprite": "adventurer",
    "stats": {
      "maxHp": 18,
      "attack": 5,
      "defense": 1
    },
    "abilities": [],
    "items": {},
    "traits": []
  },
  "flags": {
    "beastPathUnlocked": {
      "initial": false,
      "description": "リオから獣道を教わった"
    },
    "ruinsShortcutOpen": {
      "initial": false,
      "description": "遺跡の岩の隙間（近道）が開通した"
    },
    "sentinelCalmed": {
      "initial": false,
      "description": "遺跡の石像の番人を倒した"
    },
    "questComplete": {
      "initial": false,
      "description": "長老に報告してクエスト完了"
    },
    "veteran": {
      "initial": false,
      "description": "3体倒して戦いに慣れた（攻撃+1済み）"
    },
    "runeDoorOpen": {
      "initial": false,
      "description": "封印の暗号錠を開けた"
    }
  },
  "variables": {
    "gold": {
      "initial": 0,
      "min": 0,
      "label": "ゴールド",
      "hud": true,
      "description": "所持金"
    },
    "spirit": {
      "initial": 3,
      "min": 0,
      "max": 9,
      "label": "気力",
      "hud": true,
      "description": "技に使う。8歩ごとに1回復"
    },
    "victories": {
      "initial": 0,
      "min": 0,
      "label": "撃破数",
      "description": "倒した魔物の数"
    },
    "loot": {
      "initial": 0,
      "min": 0,
      "description": "直前に拾ったゴールド（文章表示用）"
    },
    "skill": {
      "initial": 0,
      "min": 0,
      "max": 9,
      "label": "剣の型",
      "description": "修行で身につけた型の数"
    }
  },
  "sets": {
    "clues": {
      "label": "手がかり帳",
      "show": true,
      "persist": "run",
      "description": "この旅で知ったこと",
      "entries": {
        "ancient-script": "古代文字の読み方を覚えた",
        "rune-order": "石板の言葉『風は星を巡り、岩に還る』"
      }
    },
    "memories": {
      "label": "かすかな記憶",
      "show": true,
      "persist": "meta",
      "description": "周回をこえて残る記憶",
      "entries": {
        "rune-code": "封印の暗号は「風 → 星 → 岩」",
        "wind-restored": "一度、村に風を取り戻した"
      }
    }
  },
  "endings": {
    "wind": {
      "title": "風の還る村",
      "text": "番人は眠り、村に風が戻った。\n小さな旅人の名は、しばらく村の語り草になった。"
    },
    "secret": {
      "title": "風の源へ",
      "text": "封印の奥で、風は生まれていた。\n{{name}}は誰も知らない森の奥へと歩き出した。"
    }
  },
  "intro": [
    {
      "type": "if",
      "when": {
        "compare": [
          {
            "cycle": true
          },
          ">",
          1
        ]
      },
      "then": [
        {
          "type": "message",
          "text": "（また、この森境から始まる。{{cycle}}度目の旅……何かを覚えている気がする）"
        }
      ],
      "else": []
    },
    {
      "type": "message",
      "text": "ここは森境の地。苔むした村から、あなたの旅が始まる。"
    },
    {
      "type": "choice",
      "prompt": "あなたの種族は？",
      "options": [
        {
          "id": "dwarf",
          "label": "小人 — 頑丈。致命傷を一度こらえる",
          "effects": [
            {
              "type": "grantTrait",
              "trait": "dwarf"
            }
          ]
        },
        {
          "id": "beastfolk",
          "label": "獣人 — 力強い。獣道を最初から知っている",
          "effects": [
            {
              "type": "grantTrait",
              "trait": "beastfolk"
            }
          ]
        },
        {
          "id": "human",
          "label": "人間 — 器用。お金と薬草を持っている",
          "effects": [
            {
              "type": "grantTrait",
              "trait": "human"
            }
          ]
        }
      ]
    },
    {
      "type": "message",
      "text": "{{name}}は{{trait.種族}}の旅人として歩き出した。"
    }
  ],
  "maps": [
    {
      "id": "village",
      "path": "maps/village.json",
      "title": "苔森の村"
    },
    {
      "id": "elder-house",
      "path": "maps/elder-house.json",
      "title": "長老の家"
    },
    {
      "id": "ruins",
      "path": "maps/ruins.json",
      "title": "風穴の遺跡"
    }
  ],
  "tilesetPath": "tiles.json",
  "dialoguesPath": "dialogues/dialogues.json",
  "eventsPath": "events/events.json",
  "databasePath": "database.json",
  "rulesPath": "rules.json",
  "assetsPath": "assets.json",
  "systems": [
    {
      "id": "chronicle",
      "path": "systems/chronicle.ts",
      "title": "旅の日誌（TypeScript拡張の例）"
    },
    {
      "id": "rune-lock",
      "path": "systems/rune-lock.ts",
      "title": "暗号錠（独自画面の例）"
    },
    {
      "id": "lantern",
      "path": "systems/lantern.ts",
      "title": "遺跡の暗闇と灯り（描画レイヤーの例）"
    }
  ],
  "modules": {
    "novel": {},
    "puzzle": {},
    "shooter": {},
    "planner": {},
    "cards": {}
  },
  "audio": {
    "battle": "song-battle",
    "victory": "sfx-victory",
    "sfx": {
      "cursor": "sfx-cursor",
      "confirm": "sfx-confirm",
      "cancel": "sfx-cancel",
      "bump": "sfx-bump",
      "hit": "sfx-hit",
      "hurt": "sfx-hurt",
      "heal": "sfx-heal",
      "encounter": "sfx-encounter",
      "victory": "sfx-victory",
      "defeat": "sfx-defeat",
      "door": "sfx-door",
      "item": "sfx-item",
      "save": "sfx-save",
      "menu": "sfx-menu"
    },
    "volume": {
      "bgm": 0.55,
      "sfx": 0.8
    }
  },
  "assetPolicy": {
    "shareable": true,
    "sources": {},
